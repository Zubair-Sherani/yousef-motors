# Public site URL used for canonical tags, Open Graph, the sitemap, and inquiry links.
NEXT_PUBLIC_SITE_URL=https://example.com

# Web3Forms access key. Required to deliver vehicle inquiries and contact forms.
# Create a key at https://web3forms.com and restrict it to your domain.
# Put the real value in .env.local locally and in Cloudflare Pages for production.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional. Set this to /api/contact only if you use the Cloudflare Pages Function.
NEXT_PUBLIC_FORM_ENDPOINT=
